<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="WeArePlanet\Payment\Api\PaymentMethodConfigurationRepositoryInterface" type="WeArePlanet\Payment\Model\PaymentMethodConfigurationRepository" />
    <preference for="WeArePlanet\Payment\Api\PaymentMethodConfigurationManagementInterface" type="WeArePlanet\Payment\Model\PaymentMethodConfigurationManagement" />
    <preference for="WeArePlanet\Payment\Api\Data\PaymentMethodConfigurationInterface" type="WeArePlanet\Payment\Model\PaymentMethodConfiguration" />
    <preference for="WeArePlanet\Payment\Api\Data\PaymentMethodConfigurationSearchResultsInterface" type="Magento\Framework\Api\SearchResults" />
    <preference for="WeArePlanet\Payment\Api\OrderRepositoryInterface" type="WeArePlanet\Payment\Model\OrderRepository" />
    <preference for="WeArePlanet\Payment\Api\TransactionInfoRepositoryInterface" type="WeArePlanet\Payment\Model\TransactionInfoRepository" />
    <preference for="WeArePlanet\Payment\Api\TransactionInfoManagementInterface" type="WeArePlanet\Payment\Model\TransactionInfoManagement" />
    <preference for="WeArePlanet\Payment\Api\Data\TransactionInfoInterface" type="WeArePlanet\Payment\Model\TransactionInfo" />
    <preference for="WeArePlanet\Payment\Api\Data\TransactionInfoSearchResultsInterface" type="Magento\Framework\Api\SearchResults" />
    <preference for="WeArePlanet\Payment\Api\TokenInfoRepositoryInterface" type="WeArePlanet\Payment\Model\TokenInfoRepository" />
    <preference for="WeArePlanet\Payment\Api\TokenInfoManagementInterface" type="WeArePlanet\Payment\Model\TokenInfoManagement" />
    <preference for="WeArePlanet\Payment\Api\Data\TokenInfoInterface" type="WeArePlanet\Payment\Model\TokenInfo" />
    <preference for="WeArePlanet\Payment\Api\Data\TokenInfoSearchResultsInterface" type="Magento\Framework\Api\SearchResults" />
    <preference for="WeArePlanet\Payment\Api\RefundJobRepositoryInterface" type="WeArePlanet\Payment\Model\RefundJobRepository" />
    <preference for="WeArePlanet\Payment\Api\Data\RefundJobInterface" type="WeArePlanet\Payment\Model\RefundJob" />
    <preference for="WeArePlanet\Payment\Api\Data\RefundJobSearchResultsInterface" type="Magento\Framework\Api\SearchResults" />
    <preference for="WeArePlanet\PluginCore\Log\LoggerInterface" type="WeArePlanet\Payment\Logger\LoggerAdapter" />
    <preference for="WeArePlanet\PluginCore\Settings\SettingsProviderInterface" type="WeArePlanet\Payment\Model\Settings\SettingsProvider" />
    <preference for="WeArePlanet\PluginCore\Webhook\StateFetcherInterface" type="WeArePlanet\Payment\Model\Webhook\StateFetcher" />
    <preference for="WeArePlanet\PluginCore\Webhook\WebhookLifecycleHandler" type="WeArePlanet\Payment\Model\Webhook\CompositeWebhookLifecycleHandler" />
    <preference for="WeArePlanet\PluginCore\Transaction\TransactionGatewayInterface" type="WeArePlanet\Payment\TransactionGateway" />
    <preference for="WeArePlanet\PluginCore\Transaction\Completion\TransactionCompletionGatewayInterface" type="WeArePlanet\Payment\TransactionCompletionGateway" />
    <preference for="WeArePlanet\PluginCore\Transaction\Invoice\InvoiceGatewayInterface" type="WeArePlanet\Payment\InvoiceGateway" />
    <preference for="WeArePlanet\PluginCore\Webhook\WebhookManagementGatewayInterface" type="WeArePlanet\Payment\WebhookManagementGateway" />
    <preference for="WeArePlanet\PluginCore\Webhook\WebhookSignatureGatewayInterface" type="WeArePlanet\Payment\WebhookSignatureGateway" />
    <preference for="WeArePlanet\PluginCore\PaymentMethod\PaymentMethodGatewayInterface" type="WeArePlanet\Payment\PaymentMethodGateway" />
    <preference for="WeArePlanet\PluginCore\PaymentMethod\PaymentMethodRepositoryInterface" type="WeArePlanet\Payment\Model\PluginCore\PaymentMethodRepository" />
    <preference for="WeArePlanet\PluginCore\Transaction\TransactionGatewayInterface" type="WeArePlanet\Payment\TransactionGateway" />
    <preference for="WeArePlanet\PluginCore\Refund\RefundGatewayInterface" type="WeArePlanet\Payment\RefundGateway" />
    <preference for="WeArePlanet\PluginCore\Document\DocumentGatewayInterface" type="WeArePlanet\Payment\DocumentGateway" />
    <preference for="WeArePlanet\PluginCore\ManualTask\ManualTaskGatewayInterface" type="WeArePlanet\Payment\ManualTaskGateway" />
    <preference for="WeArePlanet\PluginCore\Token\TokenGatewayInterface" type="WeArePlanet\Payment\TokenGateway" />
    <preference for="WeArePlanet\PluginCore\DeliveryIndication\DeliveryIndicationGatewayInterface" type="WeArePlanet\Payment\DeliveryIndicationGateway" />
    <preference for="WeArePlanet\PluginCore\GlobalData\GlobalDataGatewayInterface" type="WeArePlanet\Payment\GlobalDataGateway" />
    <preference for="WeArePlanet\PluginCore\Charge\ChargeGatewayInterface" type="WeArePlanet\Payment\ChargeGateway" />
    <preference for="WeArePlanet\PluginCore\Sdk\ClientMetadataProviderInterface" type="WeArePlanet\Payment\Model\Settings\ClientMetadataProvider" />
    <type name="WeArePlanet\Payment\Model\ResourceModel\TokenInfo\Collection\Grid">
        <arguments>
            <argument name="resource" xsi:type="object">WeArePlanet\Payment\Model\ResourceModel\TokenInfo</argument>
        </arguments>
    </type>

    <type name="WeArePlanet\Payment\Model\Config\Structure\Reader">
        <arguments>
            <argument name="compiler" xsi:type="object">Magento\Framework\View\TemplateEngine\Xhtml\ConfigCompiler</argument>
        </arguments>
    </type>

    <type name="WeArePlanet\Payment\Console\Command\SynchronizePaymentMethods">
        <arguments>
            <argument name="paymentMethodConfigurationManagement" xsi:type="object">WeArePlanet\Payment\Api\PaymentMethodConfigurationManagementInterface\Proxy</argument>
        </arguments>
    </type>

    <!-- Webhook Listeners -->
    <type name="Magento\Framework\Lock\Backend\Database">
        <arguments>
            <argument name="path" xsi:type="string">var/lock</argument>
        </arguments>
    </type>
    <!-- Payment Gateway -->
    <virtualType name="WeArePlanetPaymentGatewayCommandPool" type="Magento\Payment\Gateway\Command\CommandPool">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="initialize" xsi:type="string">WeArePlanet\Payment\Gateway\Command\InitializeCommand</item>
                <item name="capture" xsi:type="string">WeArePlanet\Payment\Gateway\Command\CaptureCommand</item>
                <item name="void" xsi:type="string">WeArePlanet\Payment\Gateway\Command\VoidCommand</item>
                <item name="refund" xsi:type="string">WeArePlanet\Payment\Gateway\Command\RefundCommand</item>
                <item name="cancel" xsi:type="string">WeArePlanet\Payment\Gateway\Command\VoidCommand</item>
                <item name="accept_payment" xsi:type="string">WeArePlanet\Payment\Gateway\Command\AcceptPaymentCommand</item>
                <item name="deny_payment" xsi:type="string">WeArePlanet\Payment\Gateway\Command\DenyPaymentCommand</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="WeArePlanetPaymentGatewayValidatorPool" type="Magento\Payment\Gateway\Validator\ValidatorPool">
        <arguments>
            <argument name="validators" xsi:type="array"></argument>
        </arguments>
    </virtualType>

    <!-- Plugins/Interceptors -->
    <type name="Magento\Config\Model\Config\Structure\Converter">
        <plugin name="weareplanet_payment_config_structure_converter" type="WeArePlanet\Payment\Plugin\Config\Model\Config\Structure\Converter" />
    </type>
    <type name="Magento\Framework\App\Config\Initial\Converter">
        <plugin name="weareplanet_payment_config_initial_converter" type="WeArePlanet\Payment\Plugin\Framework\App\Config\Initial\Converter" />
    </type>
    <type name="Magento\Payment\Model\Config\Reader">
        <plugin name="weareplanet_payment_payment_config_reader" type="WeArePlanet\Payment\Plugin\Payment\Model\Config\Reader" />
    </type>
    <type name="Magento\Payment\Model\Method\Factory">
        <plugin name="weareplanet_payment_payment_method_factory" type="WeArePlanet\Payment\Plugin\Payment\Model\Method\Factory" />
    </type>
    <type name="Magento\Checkout\Block\Checkout\LayoutProcessor">
        <plugin name="weareplanet_payment_checkout_layout_processor" type="WeArePlanet\Payment\Plugin\Checkout\Block\Checkout\LayoutProcessor" />
    </type>
    <type name="Magento\Sales\Model\Service\CreditmemoService">
        <plugin name="weareplanet_payment_sales_creditmemo_service" type="WeArePlanet\Payment\Plugin\Sales\Model\Service\CreditmemoService" />
    </type>
    <type name="Magento\Sales\Model\AdminOrder\Create">
        <plugin name="weareplanet_payment_sales_adminorder_create" type="WeArePlanet\Payment\Plugin\Sales\Model\AdminOrder\Create" />
    </type>
    <type name="Magento\Customer\Model\AccountManagement">
        <plugin name="weareplanet_payment_customer_accountmanagement" type="WeArePlanet\Payment\Plugin\Customer\Model\AccountManagement" />
    </type>
    <type name="Magento\Sales\Model\ResourceModel\Order\Handler\State">
        <plugin name="weareplanet_payment_sales_order_handler_state" type="WeArePlanet\Payment\Plugin\Sales\Model\ResourceModel\Order\Handler\State" />
    </type>

    <!-- Console Commands -->
    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="synchronizePaymentMethodsCommand" xsi:type="object">WeArePlanet\Payment\Console\Command\SynchronizePaymentMethods</item>
            </argument>
        </arguments>
    </type>

    <!-- =================================================================== -->
    <!-- Must stay a virtual type, with no <preference> for SdkProvider,     -->
    <!-- because plugin-core is not a Magento module, so setup:di:compile    -->
    <!-- ignores optional <type> arguments for its classes, and a preference -->
    <!-- makes the compiler build SdkProvider with no arguments at all.      -->
    <!-- =================================================================== -->

    <virtualType name="WeArePlanet\Payment\SdkProvider" type="WeArePlanet\PluginCore\Sdk\SdkProvider">
        <arguments>
            <argument name="settings" xsi:type="object">WeArePlanet\PluginCore\Settings\Settings</argument>
            <argument name="clientMetadataProvider" xsi:type="object">WeArePlanet\PluginCore\Sdk\ClientMetadataProviderInterface</argument>
            <argument name="cache" xsi:type="object">WeArePlanet\Payment\Model\PluginCache\PluginCache</argument>
        </arguments>
    </virtualType>

    <!-- =================================================================== -->
    <!-- Unified logging: single shared file for all WhitelabelMachineName log output       -->
    <!-- =================================================================== -->

    <virtualType name="WeArePlanet\Payment\Logger\Handler\File" type="WeArePlanet\Payment\Logger\Handler\GenericFileHandler">
        <arguments>
            <argument name="settings" xsi:type="object">WeArePlanet\PluginCore\Settings\Settings</argument>
            <argument name="filesystem" xsi:type="object">Magento\Framework\Filesystem\Driver\File</argument>
            <argument name="fileName" xsi:type="string">/var/log/weareplanet.log</argument>
        </arguments>
    </virtualType>
    <virtualType name="WeArePlanet\Payment\Logger\Logger" type="Magento\Framework\Logger\Monolog">
        <arguments>
            <argument name="name" xsi:type="string">weareplanet</argument>
            <argument name="handlers" xsi:type="array">
                <item name="system" xsi:type="object">WeArePlanet\Payment\Logger\Handler\File</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="WeArePlanet\Payment\Logger\LoggerAdapter" type="WeArePlanet\Payment\Logger\PluginCoreLoggerAdapter">
        <arguments>
            <argument name="logger" xsi:type="object">WeArePlanet\Payment\Logger\Logger</argument>
        </arguments>
    </virtualType>

    <!-- =================================================================== -->
    <!-- PluginCore gateways/services: constructor args unrelated to logging -->
    <!-- are kept; the logger argument is dropped since it now resolves via  -->
    <!-- the global WeArePlanet\PluginCore\Log\LoggerInterface     -->
    <!-- preference above.                                                  -->
    <!-- =================================================================== -->

    <virtualType name="WeArePlanet\Payment\TransactionGateway" type="WeArePlanet\PluginCore\Sdk\WebServiceAPIV2\TransactionGateway">
        <arguments>
            <argument name="sdkProvider" xsi:type="object">WeArePlanet\Payment\SdkProvider</argument>
            <argument name="settings" xsi:type="object">WeArePlanet\PluginCore\Settings\Settings</argument>
        </arguments>
    </virtualType>

    <!-- Shared file handler. Each domain configures it with its own fileName via a virtualType. -->
    <type name="WeArePlanet\Payment\Logger\Handler\GenericFileHandler">
        <arguments>
            <argument name="settings" xsi:type="object">WeArePlanet\PluginCore\Settings\Settings</argument>
            <argument name="filesystem" xsi:type="object">Magento\Framework\Filesystem\Driver\File</argument>
        </arguments>
    </type>

    <virtualType name="WeArePlanet\Payment\TransactionCompletionGateway"
                 type="WeArePlanet\PluginCore\Sdk\WebServiceAPIV2\TransactionCompletionGateway">
        <arguments>
            <argument name="sdkProvider" xsi:type="object">WeArePlanet\Payment\SdkProvider</argument>
        </arguments>
    </virtualType>

    <virtualType name="WeArePlanet\Payment\InvoiceGateway"
                 type="WeArePlanet\PluginCore\Sdk\WebServiceAPIV2\InvoiceGateway">
        <arguments>
            <argument name="sdkProvider" xsi:type="object">WeArePlanet\Payment\SdkProvider</argument>
        </arguments>
    </virtualType>

    <type name="WeArePlanet\PluginCore\Transaction\TransactionService">
        <arguments>
            <argument name="gateway" xsi:type="object">WeArePlanet\Payment\TransactionGateway</argument>
        </arguments>
    </type>

    <type name="WeArePlanet\PluginCore\LineItem\LineItemConsistencyService">
        <arguments>
            <argument name="settings" xsi:type="object">WeArePlanet\PluginCore\Settings\Settings</argument>
        </arguments>
    </type>

    <virtualType name="WeArePlanet\Payment\RefundGateway" type="WeArePlanet\PluginCore\Sdk\WebServiceAPIV2\RefundGateway">
        <arguments>
            <argument name="sdkProvider" xsi:type="object">WeArePlanet\Payment\SdkProvider</argument>
        </arguments>
    </virtualType>

    <virtualType name="WeArePlanet\Payment\TokenGateway" type="WeArePlanet\PluginCore\Sdk\WebServiceAPIV2\TokenGateway">
        <arguments>
            <argument name="sdkProvider" xsi:type="object">WeArePlanet\Payment\SdkProvider</argument>
        </arguments>
    </virtualType>

    <virtualType name="WeArePlanet\Payment\DeliveryIndicationGateway" type="WeArePlanet\PluginCore\Sdk\WebServiceAPIV2\DeliveryIndicationGateway">
        <arguments>
            <argument name="sdkProvider" xsi:type="object">WeArePlanet\Payment\SdkProvider</argument>
        </arguments>
    </virtualType>

    <virtualType name="WeArePlanet\Payment\GlobalDataGateway" type="WeArePlanet\PluginCore\Sdk\WebServiceAPIV2\GlobalDataGateway">
        <arguments>
            <argument name="sdkProvider" xsi:type="object">WeArePlanet\Payment\SdkProvider</argument>
        </arguments>
    </virtualType>

    <virtualType name="WeArePlanet\Payment\ChargeGateway" type="WeArePlanet\PluginCore\Sdk\WebServiceAPIV2\ChargeGateway">
        <arguments>
            <argument name="sdkProvider" xsi:type="object">WeArePlanet\Payment\SdkProvider</argument>
        </arguments>
    </virtualType>

    <virtualType name="WeArePlanet\Payment\DocumentGateway" type="WeArePlanet\PluginCore\Sdk\WebServiceAPIV2\DocumentGateway">
        <arguments>
            <argument name="sdkProvider" xsi:type="object">WeArePlanet\Payment\SdkProvider</argument>
        </arguments>
    </virtualType>

    <type name="WeArePlanet\PluginCore\Refund\RefundService">
        <arguments>
            <argument name="gateway" xsi:type="object">WeArePlanet\Payment\RefundGateway</argument>
        </arguments>
    </type>

    <virtualType name="WeArePlanet\Payment\PaymentMethodGateway" type="WeArePlanet\PluginCore\Sdk\WebServiceAPIV2\PaymentMethodGateway">
        <arguments>
            <argument name="sdkProvider" xsi:type="object">WeArePlanet\Payment\SdkProvider</argument>
        </arguments>
    </virtualType>

    <virtualType name="WeArePlanet\Payment\ManualTaskGateway" type="WeArePlanet\PluginCore\Sdk\WebServiceAPIV2\ManualTaskGateway">
        <arguments>
            <argument name="sdkProvider" xsi:type="object">WeArePlanet\Payment\SdkProvider</argument>
        </arguments>
    </virtualType>

    <virtualType name="WeArePlanet\Payment\WebhookManagementGateway" type="WeArePlanet\PluginCore\Sdk\WebServiceAPIV2\WebhookManagementGateway">
        <arguments>
            <argument name="sdkProvider" xsi:type="object">WeArePlanet\Payment\SdkProvider</argument>
        </arguments>
    </virtualType>

    <type name="WeArePlanet\PluginCore\Webhook\DefaultStateFetcher">
        <arguments>
            <argument name="sdkProvider" xsi:type="object">WeArePlanet\Payment\SdkProvider</argument>
            <argument name="settings" xsi:type="object">WeArePlanet\PluginCore\Settings\Settings</argument>
        </arguments>
    </type>

    <type name="WeArePlanet\Payment\Model\Webhook\RegistryConfigurer">
        <arguments>
            <argument name="objectManager" xsi:type="object">Magento\Framework\ObjectManagerInterface\Proxy</argument>
            <argument name="webhookProcessor" xsi:type="object">WeArePlanet\PluginCore\Webhook\WebhookProcessor</argument>
        </arguments>
    </type>

    <virtualType name="WeArePlanet\Payment\WebhookSignatureGateway" type="WeArePlanet\PluginCore\Sdk\WebServiceAPIV2\WebhookSignatureGateway">
        <arguments>
            <argument name="sdkProvider" xsi:type="object">WeArePlanet\Payment\SdkProvider</argument>
        </arguments>
    </virtualType>

    <type name="WeArePlanet\Payment\Model\Webhook\CompositeWebhookLifecycleHandler">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="Transaction" xsi:type="object">WeArePlanet\Payment\Model\Webhook\Transaction\TransactionWebhookLifecycleHandler</item>
                <item name="Refund" xsi:type="object">WeArePlanet\Payment\Model\Webhook\Refund\RefundWebhookLifecycleHandler</item>
                <item name="DeliveryIndication" xsi:type="object">WeArePlanet\Payment\Model\Webhook\DeliveryIndication\DeliveryIndicationWebhookLifecycleHandler</item>
                <item name="TransactionCompletion" xsi:type="object">WeArePlanet\Payment\Model\Webhook\TransactionCompletion\TransactionCompletionWebhookLifecycleHandler</item>
                <item name="TransactionInvoice" xsi:type="object">WeArePlanet\Payment\Model\Webhook\TransactionInvoice\TransactionInvoiceWebhookLifecycleHandler</item>
            </argument>

            <argument name="defaultHandler" xsi:type="object">WeArePlanet\Payment\Model\Webhook\DefaultWebhookLifecycleHandler</argument>
        </arguments>
    </type>

    <preference for="WeArePlanet\Payment\Api\PaymentMetadataManagementInterface" type="WeArePlanet\Payment\Model\PaymentMetadataManagement" />
    <preference for="WeArePlanet\Payment\Api\GuestPaymentMetadataManagementInterface" type="WeArePlanet\Payment\Model\GuestPaymentMetadataManagement" />
</config>
